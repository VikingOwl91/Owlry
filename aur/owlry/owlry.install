## owlry .install hook
##
## Keep package hooks informational: pacman runs them as root, so they must
## never inspect or modify user home directories. Migration conflicts are
## handled declaratively by PKGBUILD's replaces/conflicts arrays.

post_upgrade() {
    local old_pkgver="$2"
    case "$old_pkgver" in
        0.*|1.*)
            cat <<'EOF'

  owlry 2.x migration notes:
    - The `owlryd` binary was replaced by `owlry -d`.
    - User units are now `owlry.service` and `owlry.socket`.
    - Remove stale units from ~/.config/systemd/user/ if they override the
      package units in /usr/lib/systemd/user/.
    - Replace remaining `owlryd` references in compositor autostart configs.

  Then reload and start the packaged service as your regular user:
      systemctl --user daemon-reload
      systemctl --user enable --now owlry.service

EOF
            ;;
        *)
            # No version comparison here: the hook runs as root and cannot
            # inspect per-user units. Print both modes for every 2.x upgrade;
            # the socket text also covers a path already lost in 2.7 or older.
            cat <<'EOF'

  Owlry upgraded. Restart the daemon so the UI and daemon share the current
  IPC activation schema. Choose the section that matches how you start it.

  Socket activation (owlry.socket):
    Owlry 2.7 and earlier did not adopt the listener systemd passed. They
    replaced the socket file at that path and removed it again on shutdown,
    leaving owlry.socket active with a path that no longer exists. Restarting
    only owlry.service then fails, because the daemon now inherits a listener
    whose path is gone. Rebind the path by stopping both units first:
        systemctl --user stop owlry.service owlry.socket && systemctl --user start owlry.socket
    If the service hits its start limit, run:
        systemctl --user reset-failed owlry.service owlry.socket
    Then repeat the command above.
    Both units must stop successfully before the socket starts again. Then
    launch owlry; the client triggers service activation.
    Owlry 2.8.0 and later no longer remove an inherited socket path, but a
    path already lost before the upgrade stays lost until the socket unit
    restarts.

  Service without socket activation:
        systemctl --user restart owlry.service  # only when it is running
    If it is not running, start it as a separate step:
        systemctl --user start owlry.service

  Manually started daemon (owlry -d or compositor autostart):
    Stop the old process, then start `owlry -d` again.

  This hook is informational. It does not enable, restart, or reload units.

EOF
            ;;
    esac
}

post_install() {
    cat <<'EOF'

  owlry installed. Start the daemon with:
      systemctl --user enable --now owlry.service

  Or run ad-hoc:
      owlry -d &
      owlry

  Configuration: ~/.config/owlry/config.toml
  Diagnostics:   owlry doctor

EOF
}

post_remove() {
    echo "  owlry removed. Configuration in ~/.config/owlry remains intact."
}
